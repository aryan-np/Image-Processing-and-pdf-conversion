DEBUG=True
SECRET_KEY=django-insecure-slotlab-dev-key-change-me
GEN_BACKEND=thread
GEN_WORKERS=2
GEN_TIMELIMIT_SECONDS=120
UPLOAD_MAX_MB=10
UPLOAD_MIN_SHORT_SIDE=800
UPLOAD_MAX_MEGAPIXELS=50
UPLOAD_BLUR_THRESHOLD=100.0
UPLOAD_ALLOW_WEBP=true
UPLOAD_ALLOW_HEIC=false
ENHANCE_ENABLED=true
OCR_LANGUAGES=eng
# Master toggle for FALLBACK OCR (OSD on ambiguous orientation).
# true  = FALLBACK sessions may call Tesseract OSD when orientation is ambiguous.
# false = FALLBACK behaves like OFF (no OCR ever); ALWAYS is unaffected.
OCR_FALLBACK_ENABLED=true
